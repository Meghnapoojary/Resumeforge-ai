# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Free MongoDB Atlas cluster (M0 tier) connection string, e.g.
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/resume-builder
MONGODB_URI=

# Any long random string - used to sign auth session tokens. Generate one with:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL your app runs on. For local dev, leave as-is.
NEXTAUTH_URL=http://localhost:3000
